default:
    @just --list

# Install JS dependencies
[group('setup')]
deps:
    npm ci

[private]
deps-if-needed:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d node_modules ]; then
        npm ci
    fi

# Remove build artifacts
[group('setup')]
clean:
    rm -rf .vitepress/dist .vitepress/cache

# Serve locally
[group('build')]
dev: deps-if-needed generate
    npx vitepress dev

# Build static site
[group('build')]
build: deps-if-needed generate
    npx vitepress build

# Preview production build
[group('build')]
preview: deps-if-needed build
    npx vitepress preview

# Deploy to Vercel production
[group('build')]
deploy: build
    vc --prod

# All generated docs + OG images
[group('gen')]
generate: deps-if-needed
    cd ../cli && dart run tool/gen_models.dart
    cd ../cli && dart run tool/generate_website_api.dart
    cd ../cli && dart run tool/generate_site_reference.dart
    cp ../cli/CHANGELOG.md generated/cli-changelog.md
    npm run og
    npx prettier --write ./generated/*.md

# Reference files only (models, runtimes, config, sessions, changelog)
[group('gen')]
generate-reference:
    cd ../cli && dart run tool/generate_site_reference.dart
    cp ../cli/CHANGELOG.md generated/cli-changelog.md
    npx prettier --write ./generated/*.md

# Per-page OpenGraph images → public/og/
[group('gen')]
og: deps-if-needed
    npm run og

# Consistency check + build (generated/ drift: just gen-check)
[group('check')]
check: check-consistency build

# Feature-status labels, banned terms, install-snippet uniqueness
[group('check')]
check-consistency:
    cd ../cli && dart run tool/check_site_consistency.dart
